# MongoDB settings
MONGO_URI=mongodb://localhost:27030
MONGO_DB=threatguard
MONGO_HOST=localhost
MONGO_PORT=27030

# FastAPI settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Security settings
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Frontend settings
BACKEND_URL=http://backend:8000
STREAMLIT_SERVER_PORT=8501

# App settings
APP_ENV=development
APP_NAME=ThreatGuard AI

# Development-only one-time administrator bootstrap. Do not set these until you
# intentionally run: python -m backend.app.bootstrap_admin --confirm
THREATGUARD_BOOTSTRAP_ADMIN_EMAIL=
THREATGUARD_BOOTSTRAP_ADMIN_PASSWORD=
THREATGUARD_BOOTSTRAP_ORG_ID=
THREATGUARD_BOOTSTRAP_ORG_NAME=
THREATGUARD_BOOTSTRAP_TENANT_ID=
THREATGUARD_BOOTSTRAP_TENANT_NAME=

# Phase 4B/4C AI analyst chat (Ollama is optional and is not started by Docker Compose)
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1000
AI_TIMEOUT_SECONDS=60
AI_HISTORY_WINDOW=8
AI_CONTEXT_MAX_CHARS=8000
AI_MAX_MESSAGE_CHARS=4000
AI_RATE_LIMIT_PER_MINUTE=10
CHAT_RAG_ENABLED=true
CHAT_RAG_TOP_K=5
CHAT_RAG_MIN_SIMILARITY=0.30
CHAT_SCANNER_CONTEXT_LIMIT=5

# Knowledge base and semantic retrieval (CPU is the memory-conscious default)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=.cache/models
KB_MAX_UPLOAD_BYTES=10485760
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVAL_TOP_K=5
KB_MAX_QUERY_CHARS=1000
KB_ATLAS_VECTOR_SEARCH_ENABLED=false
KB_ATLAS_VECTOR_INDEX=kb_chunks_vector

